      "script": "#!/bin/bash\n\n#get DTKROOT by env.sh location\nDTKROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)/$(basename \"${BASH_SOURCE[0]}\")\"\nexport HYHAL_PATH=/opt/hyhal\nexport DTKROOT=$(dirname $DTKROOT)\nexport AMDGPU_TARGETS=\"gfx906;gfx926;gfx928;gfx936;gfx938\"\nexport ROCM_PATH=$DTKROOT\nexport HIP_PATH=${ROCM_PATH}/hip\nexport MIOPEN_FIND_MODE=3\n\nif [ ! -d ${HYHAL_PATH}/lib ];then\n  echo \"WARNING: ${HYHAL_PATH}/lib doesn't exist, please install the driver or set the correct hyhal path\"\n  echo \"The DTK hyhal will be used in default\"\n  export PATH=$ROCM_PATH/.hyhal/bin:$PATH\n  export LD_LIBRARY_PATH=$ROCM_PATH/.hyhal/lib:$ROCM_PATH/.hyhal/lib64:$LD_LIBRARY_PATH\n  export C_INCLUDE_PATH=$ROCM_PATH/.hyhal/include:${C_INCLUDE_PATH}\n  export CPLUS_INCLUDE_PATH=$ROCM_PATH/.hyhal/include:${CPLUS_INCLUDE_PATH}\nfi\n\nif [ ! -d \"${HYHAL_PATH}/lib/cmake/rocm_smi\" ] ||\n   ( [ -e \"${HYHAL_PATH}/lib/librocm_smi64.so\" ] &&\n     [ -e \"${HYHAL_PATH}/lib/librocm_smi64.so.1\" ] ); then\n  echo \"WARNING: ${HYHAL_PATH}/lib/cmake/rocm_smi doesn't exist, please install the latest driver(version >= 6.3.15)\"\n  echo \"The rocm_smi_lib will be used in default\"\n  export CMAKE_PREFIX_PATH=$ROCM_PATH/.hyhal/rocm_smi/:$CMAKE_PREFIX_PATH\n  export PATH=$ROCM_PATH/.hyhal/rocm_smi/bin:$PATH\n  export LD_LIBRARY_PATH=$ROCM_PATH/.hyhal/rocm_smi/lib:$LD_LIBRARY_PATH\n  export LIBRARY_PATH=${ROCM_PATH}/.hyhal/rocm_smi/lib:$LIBRARY_PATH\n  export C_INCLUDE_PATH=$ROCM_PATH/.hyhal/rocm_smi/include:${C_INCLUDE_PATH}\n  export CPLUS_INCLUDE_PATH=$ROCM_PATH/.hyhal/rocm_smi/include:${CPLUS_INCLUDE_PATH}\nfi\n\nif [ ! -f ${HYHAL_PATH}/bin/hy-smi ];then\n  export PATH=$ROCM_PATH/.hyhal/bin:$PATH\nfi\n\nexport CMAKE_PREFIX_PATH=/opt/hyhal:$CMAKE_PREFIX_PATH\nexport PATH=$ROCM_PATH/bin:$ROCM_PATH/llvm/bin:$ROCM_PATH/hip/bin:$ROCM_PATH/hip/bin/hipify:$HYHAL_PATH/bin:${ROCM_PATH}/opencl/bin:$PATH\nexport LD_LIBRARY_PATH=${ROCM_PATH}/lib:${ROCM_PATH}/lib64:$HYHAL_PATH/lib:$HYHAL_PATH/lib64:${ROCM_PATH}/dushmem/lib:${ROCM_PATH}/opencl/lib:$LD_LIBRARY_PATH\nexport LD_LIBRARY_PATH=${ROCM_PATH}/dcc/gcvm/lib:${ROCM_PATH}/hip/lib:${ROCM_PATH}/llvm/lib:$LD_LIBRARY_PATH\nexport LIBRARY_PATH=$HYHAL_PATH/lib:${ROCM_PATH}/opencl/lib:${ROCM_PATH}/dushmem/lib${LIBRARY_PATH:+:${LIBRARY_PATH}}\nexport C_INCLUDE_PATH=${ROCM_PATH}/include:$HYHAL_PATH/include:${ROCM_PATH}/llvm/include:${ROCM_PATH}/opencl/include${C_INCLUDE_PATH:+:${C_INCLUDE_PATH}}\nexport C_INCLUDE_PATH=${ROCM_PATH}/dcc/gcvm/include:${C_INCLUDE_PATH}\nexport CPLUS_INCLUDE_PATH=${ROCM_PATH}/dcc/gcvm/include:${ROCM_PATH}/include:$HYHAL_PATH/include:${ROCM_PATH}/llvm/include:${ROCM_PATH}/dushmem/include:${ROCM_PATH}/opencl/include${CPLUS_INCLUDE_PATH:+:${CPLUS_INCLUDE_PATH}}\n\n"
