      "export C_INCLUDE_PATH=${ROCM_PATH}/include:$HYHAL_PATH/include:${ROCM_PATH}/llvm/include:${ROCM_PATH}/opencl/include${C_INCLUDE_PATH:+:${C_INCLUDE_PATH}}",
      "export C_INCLUDE_PATH=${ROCM_PATH}/dcc/gcvm/include:${C_INCLUDE_PATH}",
      "export CPLUS_INCLUDE_PATH=${ROCM_PATH}/dcc/gcvm/include:${ROCM_PATH}/include:$HYHAL_PATH/include:${ROCM_PATH}/llvm/include:${ROCM_PATH}/dushmem/include:${ROCM_PATH}/opencl/include${CPLUS_INCLUDE_PATH:+:${CPLUS_INCLUDE_PATH}}"
